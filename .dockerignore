# Keep the build context (and the image) small. `out/` alone is tens of MB of
# scan artifacts and reports that must never end up baked into the image.
.git
.gitignore
out/
samples/
__pycache__/
**/__pycache__/
*.egg-info/
.pytest_cache/
.venv/
tools/semgrep-venv/
.env
.agents/
.codex/

# Development only: the job runs the agent, it never runs its tests, scripts or docs.
# Kept: appsec_triage/, configs/, prompts/, pyproject.toml and LICENSE (pyproject's
# license-files needs it for `pip install -e .`).
tests/
tools/
docs/
ci/
*.patch
*.md
.env.example
.ruff_cache/
Dockerfile
appsec_triage/llm/mailbox.py
configs/providers/mailbox.yaml
