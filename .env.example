# AppSecTriage — environment for the analysis job. Copy to `.env`, fill in, and
# pass to the container with `docker run --env-file .env ...`.
# `.env` itself must stay OUT of git (see .gitignore) — it holds live secrets.

# ── Provider selection ───────────────────────────────────────────────────────
# Which provider profile under configs/providers/ to use. Passed on the CLI with
# `-p <name>`; this var is only a convenience for wrapper scripts.
#   deepseek → cheapest + most accurate on the corpus (recommended for CI)
#   openai   → external API; only on public/OSS code or with redaction + DPA
#   ollama   → fully local, nothing leaves the perimeter (air-gapped default)
APPSEC_PROVIDER=deepseek

# ── DeepSeek (recommended) ───────────────────────────────────────────────────
# REQUIRED when using -p deepseek. External API in CN jurisdiction — clear the
# compliance review before pointing it at internal code.
DEEPSEEK_API_KEY=
# Optional overrides (sane defaults baked into configs/providers/deepseek.yaml):
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── OpenAI (optional) ────────────────────────────────────────────────────────
# REQUIRED only when using -p openai.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Ollama (optional, local inference) ───────────────────────────────────────
# No API key. Point at the host running Ollama. Inside a container, localhost is
# the container itself — use the host address (e.g. http://host.docker.internal:11434
# or the LAN IP of the GPU box).
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=qwen3-coder:30b

# ── Toolchain paths (already baked into the image; override only if you must) ─
# PHPACTOR_PHAR=/opt/phpactor.phar
