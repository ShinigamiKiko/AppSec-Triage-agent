.env
out/
__pycache__/
*.egg-info/
.pytest_cache/
.venv/
# Seeded projects install their dependencies locally; only the lockfiles belong in git.
samples/**/vendor/
samples/**/node_modules/

# Корпуса, собранные из реального кода, в репозиторий инструмента не попадают.
# Один такой уже был собран по ошибке: 44 записи, 26 файлов, 26 КБ исходников
# трёх внутренних проектов — целые тела методов с настоящими именами классов.
# Инструмент, который специально прячет секреты от внешней модели, не должен
# сам возить чужой код в своих сэмплах. Синтетические корпуса (corpus.jsonl,
# corpus-php.jsonl) остаются — в них выдуманный код.
samples/corpus-*.jsonl
!samples/corpus.jsonl
!samples/corpus-php.jsonl

